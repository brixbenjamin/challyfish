  "doctrine_entries": [
    {
      "id": "ffffffff-0000-0000-0000-000000000001",
      "group_id": "eeeeeeee-0000-0000-0000-000000000001",
      "title": "The Domesticated State",
      "body_md": "Safety, predictability and a single-file path, traded for the ability to choose your own. Nobody forced it on you. That is what makes it hard to see.",
      "related_archetype_id": null,
      "sort": 1,
      "min_app_version": 1,
      "created_at": "2026-09-08T07:52:53.772026+00:00",
      "updated_at": "2026-09-08T07:52:53.772026+00:00"
    },
    {
      "id": "ffffffff-0000-0000-0000-000000000002",
      "group_id": "eeeeeeee-0000-0000-0000-000000000001",
      "title": "Thought Corruption",
      "body_md": "Reading about it is not doing it. Collecting one more framework is the most comfortable way to avoid acting, because it feels like progress.",
      "related_archetype_id": null,
      "sort": 2,
      "min_app_version": 1,
      "created_at": "2026-09-08T07:52:53.772026+00:00",
      "updated_at": "2026-09-08T07:52:53.772026+00:00"
    },
    {
      "id": "ffffffff-0000-0000-0000-000000000003",
      "group_id": "eeeeeeee-0000-0000-0000-000000000002",
      "title": "Thumos",
      "body_md": "The drive to be seen, to assert, to leave a mark on the physical world. Not willpower and not grit — both of those lose the half about being seen.",
      "related_archetype_id": null,
      "sort": 1,
      "min_app_version": 1,
      "created_at": "2026-09-08T07:52:53.772026+00:00",
      "updated_at": "2026-09-08T07:52:53.772026+00:00"
    }
  ],
