# OS
.DS_Store

# Editors
.idea/
.vscode/

# Secrets. The client may only ever carry SUPABASE_URL and the anon key, and
# the service role key never enters this repository — an unignored .env is
# exactly how that rule gets broken by accident.
.env*
!.env.example
app/env.json
app/env.device.json

# --- Graphify generated output (index, not source of record) ---
graphify-out/cost.json
graphify-out/cache/
app/env.prod.json

# Design context symlinks into the sibling planning workspace (feral-maxxing).
# Local convenience so /impeccable tooling resolves them from here; the specs
# themselves live in feral-maxxing per the README, not in this repo.
/PRODUCT.md
/DESIGN.md
